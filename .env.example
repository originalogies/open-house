# Local development settings. Copy this file to ".env" (which git ignores) and fill in the values.
# Run the site locally with: npm run dev   (opens http://localhost:8888)
#
# Never commit real keys. Only ".env.example" is tracked by git.

# Google OAuth Web client ID. Add http://localhost:8888 as an Authorized JavaScript origin on that client.
GOOGLE_CLIENT_ID=

# Any random string of 32+ characters. Use a different one from production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Admins can always sign in and use /admin/ and /inventory/.
ADMIN_EMAILS=

# Optional starting allowlist (admins can also manage it at /admin/).
ALLOWED_DOMAINS=synergyrealtors.com
ALLOWED_EMAILS=

# Use your OWN address here while testing so real team emails are not sent.
TEAM_EMAIL=

# Optional extra people who may use /inventory/ and approve requests.
TEAM_EMAILS=

# A real Resend key sends real emails, even locally. Leave blank to skip email (requests will save but report an email error).
RESEND_API_KEY=

# Read-only Repliers key for listings.
REPLIERS_API_KEY=
