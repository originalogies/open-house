# Local development settings. Copy this file to ".env" (which git ignores) and fill in the values.
# Run the site locally with: npm run dev   (opens http://localhost:8888)
#
# Never commit real keys. Only ".env.example" is tracked by git.

# Google OAuth Web client ID. Add http://localhost:8888 as an Authorized JavaScript origin on that client.
GOOGLE_CLIENT_ID=

# Any random string of 32+ characters. Use a different one from production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Admins can always sign in and use /admin/ and /inventory/.
ADMIN_EMAILS=

# Optional starting allowlist (admins can also manage it at /admin/).
ALLOWED_DOMAINS=synergyrealtors.com
ALLOWED_EMAILS=

# Use your OWN address here while testing so real team emails are not sent.
TEAM_EMAIL=

# Optional extra people who may use /inventory/ and approve requests.
TEAM_EMAILS=

# A real Resend key sends real emails, even locally. Leave blank to skip email (requests will save but report an email error).
RESEND_API_KEY=

# Read-only Repliers key for listings.
REPLIERS_API_KEY=

# MLS automation (see docs/MLS_AUTOMATION.md). off = the team enters the MLS by hand (default),
# dry_run = the bot fills the form but doesn't submit, live = the bot submits.
MLS_BOOKING_MODE=off
# Where approved open houses are sent for MLS entry: Grokbot's Cursor automation webhook,
# e.g. https://api2.cursor.sh/automations/webhook/<id>, and the crsr_... token Cursor gave for it.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_TOKEN=
# 32+ random characters; never leaves the portal. Makes each job's one-time callback token (the bot sends
# it back with the result) and signs outgoing jobs. Generate with: openssl rand -base64 32
MLS_WEBHOOK_SECRET=
# Optional. The bot calls back the site a request was made on (http://localhost:8888 here), which a bot
# on another computer can't reach. To test locally with the real bot, expose this copy with a tunnel
# and set its callback address, e.g. https://<your-tunnel>/api/mls/callback
MLS_CALLBACK_URL=

# Support and Referral Agreement (DocuSeal). With both set, agents must sign it before using the portal.
# Locally, "Read and sign" opens the real DocuSeal form, and DocuSeal brings you back to http://localhost:8888.
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=
# Optional: the DocuSeal webhook's secret (header X-OH-Webhook-Secret), and the API for DocuSeal's EU cloud.
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_API_URL=
